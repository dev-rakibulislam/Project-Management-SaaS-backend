model Organization {
  id      String             @id @default(uuid())
  name    String
  slug    String             @unique
  ownerId String
  status  OrganizationStatus @default(ACTIVE)

  deletedAt DateTime?

  owner     User     @relation(fields: [id], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("organizations")
}
