model Comment {
  id String @id @default(uuid())

  content String

  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id])

  user User @relation(fields: [userId], references: [id])

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([userId])
}
