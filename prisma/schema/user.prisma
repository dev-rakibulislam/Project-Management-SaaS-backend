model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  password     String?
  googleId     String?
  platformRole PlatformRole @default(USER)
  isActive     Boolean      @default(true)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
  organizations Organization[]
}
